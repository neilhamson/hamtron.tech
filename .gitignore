# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# local recovery backups
*.before-*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local/private development state
.mi1_backups/
.npmrc

# credentials and private-key containers
*.key
*.p12
*.pfx

# local backups and deployment archives
/.local-media/
*.bak
*.backup
*.old
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
